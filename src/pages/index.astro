---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE } from '../config';
import { getPosts, url } from '../utils';

const posts = (await getPosts()).slice(0, 5);
const projets = (await getCollection('projets')).sort((a, b) => a.data.order - b.data.order).slice(0, 4);
---
<Base>
  <div class="container">
    <section class="hero">
      <div class="eyebrow">Data · Apprentissage automatique · Mathématiques appliquées</div>
      <h1>Bonjour, je suis Mathieu.</h1>
      <p>{SITE.intro}</p>
      <div class="links">
        {SITE.links.map((l) => <a href={url(l.href)} rel="me">{l.label} →</a>)}
      </div>
    </section>

    <div class="section-head">
      <h2>Derniers articles</h2>
      <a href={url('/blog/')}>Tous les articles →</a>
    </div>
    <PostList posts={posts} />

    {projets.length > 0 && (
      <>
        <div class="section-head">
          <h2>Projets</h2>
          <a href={url('/projets/')}>Tous les projets →</a>
        </div>
        <div class="project-grid">
          {projets.map((p) => <ProjectCard project={p} />)}
        </div>
      </>
    )}
  </div>
</Base>
