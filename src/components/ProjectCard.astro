---
import type { CollectionEntry } from 'astro:content';
import { t, type Lang } from '../i18n';

interface Props { project: CollectionEntry<'projets'>; lang: Lang }
const { project, lang } = Astro.props;
const { data } = project;
---
<article class="card">
  <h3>{data.title}</h3>
  <p>{data.description}</p>
  {data.stack.length > 0 && (
    <ul class="tags" style="margin-bottom:1rem">
      {data.stack.map((s) => <li class="tag">{s}</li>)}
    </ul>
  )}
  <div class="card-links">
    {data.url && <a href={data.url}>{t(lang, 'project.view')}</a>}
    {data.repo && <a href={data.repo}>{t(lang, 'project.code')}</a>}
  </div>
</article>
