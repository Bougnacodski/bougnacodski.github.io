---
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { ROUTES, t, type Lang } from '../i18n';
import { url } from '../utils';

interface Props { lang: Lang; tag: string; posts: CollectionEntry<'blog'>[] }
const { lang, tag, posts } = Astro.props;
---
<Base lang={lang} title={t(lang, 'tag.title')(tag)}>
  <div class="container">
    <a class="eyebrow" href={url(ROUTES.blog[lang])} style="text-decoration:none">{t(lang, 'tag.back')}</a>
    <h1 class="page-title" style="margin-top:.5rem">{tag}</h1>
    <p class="muted">{t(lang, 'tag.count')(posts.length)}</p>
    <PostList posts={posts} lang={lang} />
  </div>
</Base>
